# Образец настроек production. Скопируйте в .env.production и задайте свои значения.
# Сам .env.production в git не попадает.
HTTP_ADDR=:8090
DATABASE_URL=postgres://sportreg:CHANGE_ME@db:5432/sportreg?sslmode=disable
LOG_LEVEL=info
SEED_DEMO=false
# Обязателен, не короче 32 символов: openssl rand -hex 32
JWT_SECRET=CHANGE_ME
JWT_TTL=12h
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME
REDIS_ADDR=redis:6379
CACHE_ITEM_TTL=5m
CACHE_LIST_TTL=60s
